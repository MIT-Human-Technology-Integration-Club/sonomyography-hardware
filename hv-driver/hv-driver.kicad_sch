	(text "R_LED < (90V - V_REF - V_D) * R_PULLUP / (V_PULLUP - V_CEsat)\n= (90V - 2.5V - 1.4V) * 5k / (24V - 200mV)\n-> 15kOhm"
		(exclude_from_sim no)
		(at 200.406 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2962c775-2010-4ad0-8191-97571ebd05b7")
	)
	(text "2.5V"
		(exclude_from_sim no)
		(at 236.22 115.062 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5521db56-9316-4e60-a707-d31c05eebc21")
	)
	(text "R_UVLOB"
		(exclude_from_sim no)
		(at 22.86 64.262 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "80888098-e944-47f7-ae46-0150f253aef3")
	)
	(text "2.5 = 90 * 1k / (1k + 35k)"
		(exclude_from_sim no)
		(at 231.902 124.968 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "84eb1d62-38ec-44d2-9144-3af42f2762b9")
	)
	(text "D = 0.5 * Vout / (Vin + 0.5 * Vout)\n  = 0.5 * 90 / (12 + 0.5 * 90) = 0.79\n\nfSW = 250 kHz, RT = 86.6k"
		(exclude_from_sim no)
		(at 28.702 118.364 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "96399c5a-d22d-473e-9371-37d9283be0a5")
	)
	(text "R_UVLOT = 0.957 * (V_supply_on - V_supply_off) / 5 uA\n= 0.957 * (11 - 10) / 5 uA -> 100k\nR_UVLOB = 1.5V * R_UVLOT / (V_supply_on - 1.5V) = 15.7k"
		(exclude_from_sim no)
		(at 27.94 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9f5e9a30-9a1e-45fe-835b-33fbd5acfde3")
	)
	(text "** CHECK OPTOCOUPLER PARAMS **"
		(exclude_from_sim no)
		(at 211.836 84.074 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 255 16 0 1)
			)
		)
		(uuid "a11ae045-f3fc-4aa9-8e03-751f04af4b23")
	)
	(text "R_PULLUP > (V_PULLUP - 2.5) / 1.6mA\n= (24 - 2.5)/1.6mA = 13kOhm"
		(exclude_from_sim no)
		(at 114.554 98.552 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
